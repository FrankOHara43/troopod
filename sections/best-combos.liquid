{%- comment -%}
Prototype note: the combos rail is horizontal on all widths, so this implementation uses native scroll-snap and a keyboard handler instead of a JS carousel. The combo data is intended to live in combo metaobjects; the fallback block settings are only there so the section can still render safely before those entries are connected.
{%- endcomment -%}

{%- liquid
	assign combo_limit = section.settings.combo_limit | default: 5
	assign rail_label = section.settings.rail_label | default: section.settings.heading | default: 'Best selling combos'
	assign rendered_combos = 0
-%}

<section class="best-combos section" id="combos-{{ section.id }}">
	<style>
		/* Prototype-specific fallback art classes for the combo stack; Dawn has no exact equivalent for these rendered product silhouettes. */
		#shopify-section-{{ section.id }} {
			--combos-max-width: var(--page-width, 120rem);
			--combos-pad-x: 18px;
			--combos-rail-gap: 14px;
			--combos-card-width: 302px;
			--combos-card-width-mobile: 268px;
			--combos-card-padding: 0;
			--combos-ease: cubic-bezier(.2, .7, .2, 1);
			--combos-accent: #f0a03c;
			--combos-accent-deep: #c9761d;
			--combos-ink: #faf7fd;
			--combos-paper: rgba(236, 230, 247, .74);
			--combos-paper-dim: rgba(236, 230, 247, .52);
			--combos-border: rgba(236, 230, 247, .14);
			--combos-glass: linear-gradient(162deg, rgba(236, 230, 247, .13), rgba(75, 58, 143, .10));
			--combos-glass-hero: linear-gradient(162deg, rgba(236, 230, 247, .15), rgba(75, 58, 143, .12));
			--combos-shadow: 0 26px 74px rgba(18, 12, 34, .44);
			--combos-shadow-hero: 0 26px 74px rgba(18, 12, 34, .44), 0 0 0 1px rgba(240, 160, 60, .2), inset 0 1px 0 rgba(255, 255, 255, .24);
			--combos-tile-bg: rgba(236, 230, 247, .08);
			--combos-tile-border: 1px dashed rgba(236, 230, 247, .26);
			--combos-btn-bg: linear-gradient(135deg, #00706a, #004b46);
			--combos-btn-color: #f4fdf6;
		}

		#shopify-section-{{ section.id }} .best-combos {
			position: relative;
			z-index: 2;
			padding: 34px 0;
		}

		#shopify-section-{{ section.id }} .best-combos__wrap {
			max-width: var(--combos-max-width);
			margin: 0 auto;
			padding: 0 var(--combos-pad-x);
		}

		#shopify-section-{{ section.id }} .best-combos__head {
			text-align: center;
			margin-bottom: 26px;
		}

		#shopify-section-{{ section.id }} .best-combos__kicker {
			display: block;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: .22em;
			text-transform: uppercase;
			color: rgba(236, 230, 247, .52);
		}

		#shopify-section-{{ section.id }} .best-combos__heading {
			margin: 12px 0 0;
			font-family: var(--font-heading-family, 'Outfit', system-ui, sans-serif);
			font-size: clamp(30px, 4.6vw, 54px);
			line-height: .94;
			letter-spacing: -.018em;
			text-transform: uppercase;
			color: var(--combos-ink);
		}

		#shopify-section-{{ section.id }} .best-combos__rule {
			display: flex;
			align-items: center;
			gap: 13px;
			margin: 14px auto 0;
			max-width: 270px;
			justify-content: center;
		}

		#shopify-section-{{ section.id }} .best-combos__rule i {
			height: 1px;
			flex: 1;
			background: linear-gradient(90deg, rgba(236, 230, 247, .44), transparent);
		}

		#shopify-section-{{ section.id }} .best-combos__rule svg {
			width: 16px;
			height: 16px;
			color: var(--combos-accent);
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .best-combos__lede {
			margin: 14px auto 0;
			max-width: 56rem;
			color: var(--combos-paper);
			font-size: 15px;
			line-height: 1.62;
		}

		#shopify-section-{{ section.id }} .comborail {
			display: flex;
			gap: var(--combos-rail-gap);
			overflow-x: auto;
			overflow-y: hidden;
			scroll-snap-type: x mandatory;
			margin: 0 -18px;
			padding: 4px 18px 14px;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
			scroll-padding-inline: 18px;
		}

		#shopify-section-{{ section.id }} .comborail::-webkit-scrollbar {
			display: none;
		}

		#shopify-section-{{ section.id }} .comborail:focus-visible {
			outline: 2px solid var(--combos-accent);
			outline-offset: 4px;
			border-radius: 24px;
		}

		#shopify-section-{{ section.id }} .combo {
			flex: 0 0 var(--combos-card-width);
			scroll-snap-align: start;
			display: flex;
			flex-direction: column;
			padding: var(--combos-card-padding);
			transition: transform .4s var(--combos-ease);
			min-width: 0;
		}

		#shopify-section-{{ section.id }} .combo:hover {
			transform: translateY(-5px);
		}

		#shopify-section-{{ section.id }} .combo.is-featured {
			border-color: rgba(240, 160, 60, .42);
			box-shadow: var(--combos-shadow-hero);
		}

		#shopify-section-{{ section.id }} .combo__tray {
			padding: 14px 14px 13px;
			border-bottom: 1px solid rgba(236, 230, 247, .13);
			position: relative;
			background: var(--combos-glass);
		}

		#shopify-section-{{ section.id }} .combo__save {
			display: inline-block;
			font-size: 9.5px;
			font-weight: 800;
			letter-spacing: .12em;
			text-transform: uppercase;
			padding: 5px 11px;
			border-radius: 999px;
			background: rgba(3, 30, 28, .72);
			border: 1px solid rgba(240, 160, 60, .34);
			color: var(--combos-accent);
			margin-bottom: 13px;
		}

		#shopify-section-{{ section.id }} .combo__flag {
			position: absolute;
			top: 14px;
			right: 14px;
			font-size: 8.6px;
			font-weight: 800;
			letter-spacing: .1em;
			text-transform: uppercase;
			padding: 5px 10px;
			border-radius: 999px;
			background: linear-gradient(135deg, var(--combos-accent-deep), #5d8d1c);
			color: #08211a;
		}

		#shopify-section-{{ section.id }} .combo__stack {
			display: flex;
			align-items: flex-end;
			gap: 3px;
		}

		#shopify-section-{{ section.id }} .combo__item {
			flex: 1 1 0;
			min-width: 0;
			text-align: center;
		}

		#shopify-section-{{ section.id }} .combo__media-wrap {
			display: grid;
			place-items: center;
			margin: 0 auto 8px;
		}

		#shopify-section-{{ section.id }} .combo__media {
			display: block;
			width: auto;
			height: 66px;
			object-fit: contain;
			filter: drop-shadow(0 8px 13px rgba(1, 24, 22, .5));
		}

		#shopify-section-{{ section.id }} .combo__placeholder,
		#shopify-section-{{ section.id }} .combo__tile {
			width: 44px;
			height: 66px;
			margin: 0 auto 8px;
			display: grid;
			place-items: center;
			border-radius: 9px;
			background: var(--combos-tile-bg);
			border: var(--combos-tile-border);
			color: var(--combos-accent);
			overflow: hidden;
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .combo__placeholder svg,
		#shopify-section-{{ section.id }} .combo__tile svg {
			width: 17px;
			height: 17px;
		}

		#shopify-section-{{ section.id }} .combo__label {
			display: block;
			font-size: 8.6px;
			line-height: 1.32;
			color: var(--combos-paper);
			font-weight: 600;
		}

		#shopify-section-{{ section.id }} .combo__plus {
			flex: 0 0 9px;
			color: var(--combos-accent);
			font-weight: 800;
			font-size: 12px;
			padding-bottom: 30px;
			text-align: center;
		}

		#shopify-section-{{ section.id }} .combo__body {
			padding: 15px 16px 18px;
			display: flex;
			flex-direction: column;
			flex: 1;
		}

		#shopify-section-{{ section.id }} .combo__title {
			margin: 0;
			font-family: var(--font-heading-family, 'Outfit', system-ui, sans-serif);
			font-size: 16px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: -.005em;
			line-height: 1.1;
			color: var(--combos-ink);
		}

		#shopify-section-{{ section.id }} .combo__count {
			font-size: 10.5px;
			font-weight: 700;
			letter-spacing: .12em;
			text-transform: uppercase;
			color: var(--combos-paper-dim);
			margin-top: 6px;
		}

		#shopify-section-{{ section.id }} .combo__inc {
			font-size: 12.4px;
			color: var(--combos-paper);
			line-height: 1.55;
			margin: 11px 0 14px;
			flex: 1;
		}

		#shopify-section-{{ section.id }} .combo__prow {
			display: flex;
			align-items: baseline;
			gap: 9px;
			flex-wrap: wrap;
			margin-bottom: 6px;
		}

		#shopify-section-{{ section.id }} .combo__prow strong {
			font-family: var(--font-heading-family, 'Outfit', system-ui, sans-serif);
			font-size: 25px;
			font-weight: 800;
			color: var(--combos-ink);
			letter-spacing: -.02em;
			line-height: 1;
		}

		#shopify-section-{{ section.id }} .combo__prow s {
			font-size: 13px;
			color: var(--combos-paper-dim);
		}

		#shopify-section-{{ section.id }} .combo__prow em {
			font-style: normal;
			font-size: 9.5px;
			font-weight: 800;
			letter-spacing: .1em;
			text-transform: uppercase;
			padding: 4px 9px;
			border-radius: 999px;
			background: rgba(240, 160, 60, .18);
			border: 1px solid rgba(240, 160, 60, .36);
			color: var(--combos-accent);
		}

		#shopify-section-{{ section.id }} .combo__fine {
			font-size: 10px;
			color: var(--combos-paper-dim);
			margin-bottom: 12px;
		}

		#shopify-section-{{ section.id }} .combo__btn {
			width: 100%;
			justify-content: center;
		}

		#shopify-section-{{ section.id }} .btn {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			height: 46px;
			padding: 0 22px;
			border-radius: 999px;
			font-size: 12.5px;
			font-weight: 700;
			letter-spacing: .13em;
			text-transform: uppercase;
			transition: .35s var(--combos-ease);
			white-space: nowrap;
			text-decoration: none;
			border: 0;
		}

		#shopify-section-{{ section.id }} .btn svg {
			width: 15px;
			height: 15px;
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .btn-primary {
			background: var(--combos-btn-bg);
			color: var(--combos-btn-color);
			box-shadow: 0 12px 30px rgba(0, 80, 74, .26), inset 0 1px 0 rgba(255, 255, 255, .22);
		}

		#shopify-section-{{ section.id }} .btn-ghost {
			background: rgba(236, 230, 247, .10);
			border: 1px solid rgba(236, 230, 247, .30);
			color: var(--combos-ink);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
		}

		#shopify-section-{{ section.id }} .btn:hover {
			transform: translateY(-2px);
		}

		#shopify-section-{{ section.id }} .swipecue {
			display: flex;
			align-items: center;
			gap: 8px;
			justify-content: center;
			margin: 12px 0 0;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: .08em;
			text-transform: uppercase;
			color: var(--combos-paper);
		}

		#shopify-section-{{ section.id }} .swipecue svg {
			width: 14px;
			height: 14px;
			color: var(--combos-accent);
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .railnote {
			max-width: 52rem;
			margin: 10px auto 0;
			text-align: center;
			font-size: 12.2px;
			line-height: 1.5;
			color: var(--combos-paper);
		}

		#shopify-section-{{ section.id }} .best-combos__empty {
			padding: 24px;
			border-radius: 26px;
			background: linear-gradient(162deg, rgba(236, 230, 247, .10), rgba(75, 58, 143, .14));
			border: 1px solid rgba(236, 230, 247, .14);
		}

		#shopify-section-{{ section.id }} .best-combos__empty h3 {
			margin: 0 0 8px;
			font-family: var(--font-heading-family, 'Outfit', system-ui, sans-serif);
			font-size: 22px;
			text-transform: uppercase;
			letter-spacing: -.01em;
			color: var(--combos-ink);
		}

		#shopify-section-{{ section.id }} .best-combos__empty p {
			margin: 0;
			color: var(--combos-paper);
		}

		#shopify-section-{{ section.id }} .pimg {
			display: block;
			background-repeat: no-repeat;
			background-position: center bottom;
			background-size: contain;
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .p-combo2 { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 1.1247; }
		#shopify-section-{{ section.id }} .p-dish { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.624; }
		#shopify-section-{{ section.id }} .p-eraser { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 1.3187; }
		#shopify-section-{{ section.id }} .p-floor { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6312; }
		#shopify-section-{{ section.id }} .p-handwash { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.7453; }
		#shopify-section-{{ section.id }} .p-kitchen { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6387; }
		#shopify-section-{{ section.id }} .p-laundry { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6302; }
		#shopify-section-{{ section.id }} .p-metal { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6993; }
		#shopify-section-{{ section.id }} .p-tap { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6387; }
		#shopify-section-{{ section.id }} .p-toilet { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6139; }
		#shopify-section-{{ section.id }} .p-wm { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.6148; }

		@media (min-width: 760px) {
			#shopify-section-{{ section.id }} .combo {
				flex-basis: 302px;
			}

			#shopify-section-{{ section.id }} .combo__media {
				height: 66px;
			}

			#shopify-section-{{ section.id }} .combo__tile,
			#shopify-section-{{ section.id }} .combo__placeholder {
				height: 66px;
			}
		}

		@media (max-width: 760px) {
			#shopify-section-{{ section.id }} .best-combos {
				padding: 22px 0;
			}

			#shopify-section-{{ section.id }} .comborail {
				flex-basis: 268px;
				padding-bottom: 14px;
			}

			#shopify-section-{{ section.id }} .combo {
				flex-basis: var(--combos-card-width-mobile);
			}

			#shopify-section-{{ section.id }} .combo__media {
				height: 56px;
			}

			#shopify-section-{{ section.id }} .combo__tile,
			#shopify-section-{{ section.id }} .combo__placeholder {
				height: 56px;
			}
		}

		@media (max-width: 420px) {
			#shopify-section-{{ section.id }} .best-combos__heading {
				font-size: clamp(26px, 12vw, 36px);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			#shopify-section-{{ section.id }} .best-combos *,
			#shopify-section-{{ section.id }} .best-combos *::before,
			#shopify-section-{{ section.id }} .best-combos *::after {
				animation-duration: .01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: .01ms !important;
				scroll-behavior: auto !important;
			}

			#shopify-section-{{ section.id }} .combo,
			#shopify-section-{{ section.id }} .btn {
				transition: none !important;
			}
		}
	</style>

	<div class="best-combos__wrap">
		<div class="best-combos__head">
			<span class="best-combos__kicker">{{ section.settings.kicker | default: 'Pre-built to save you money' | escape }}</span>
			<h2 class="best-combos__heading">{{ section.settings.heading | default: 'Best selling combos' | escape }}</h2>
			<div class="best-combos__rule" aria-hidden="true">
				<i></i>
				{% render 'icon-leaf' %}
				<i></i>
			</div>
			{%- if section.settings.subheading != blank -%}
				<div class="best-combos__lede rte">{{ section.settings.subheading }}</div>
			{%- endif -%}
		</div>

		<div class="comborail" tabindex="0" role="region" aria-label="{{ rail_label | escape }}" data-combo-rail>
			{%- for block in section.blocks limit: combo_limit -%}
				{%- if block.type == 'combo' -%}
					{%- liquid
						assign combo_entry = block.settings.combo
						assign combo_title = block.settings.title
						assign combo_description = block.settings.description
						assign combo_badge = block.settings.badge_text
						assign combo_flag = block.settings.flag_text
						assign combo_save = block.settings.save_text
						assign combo_current_price = block.settings.current_price
						assign combo_compare_price = block.settings.compare_price
						assign combo_fine_print = block.settings.fine_print
						assign combo_cta_label = block.settings.cta_label | default: 'Shop bundle'
						assign combo_cta_link = block.settings.cta_link | default: '#bundles'
						assign combo_count_label = block.settings.count_label
						assign combo_hero = block.settings.hero_combo
						assign combo_products = block.settings.products
						assign combo_image = block.settings.image

						if combo_entry != blank
							assign combo_title = combo_entry.title.value | default: combo_entry.title | default: combo_title
							assign combo_description = combo_entry.description.value | default: combo_entry.description | default: combo_description
							assign combo_badge = combo_entry.badge_text.value | default: combo_entry.badge_text | default: combo_badge
							assign combo_products = combo_entry.products.value | default: combo_products
							assign combo_image = combo_entry.image.value | default: combo_entry.image | default: combo_image
						endif

						assign combo_product_count = combo_products.size | default: 0
						if combo_product_count == 0 and combo_image != blank
							assign combo_product_count = 1
						endif
						assign combo_count_display = combo_count_label
						if combo_count_display == blank
							assign combo_count_display = combo_product_count | append: ' products'
						endif
					-%}

					<article class="glass combo{% if combo_hero %} is-featured{% endif %}" {{ block.shopify_attributes }}>
						<div class="combo__tray">
							{%- if combo_save != blank -%}
								<span class="combo__save">{{ combo_save | escape }}</span>
							{%- endif -%}
							{%- if combo_flag != blank -%}
								<span class="combo__flag">{{ combo_flag | escape }}</span>
							{%- endif -%}

							<div class="combo__stack">
								{%- if combo_products != blank -%}
									{%- for product in combo_products limit: 5 -%}
										{%- liquid
											assign stack_label = block.settings['stack_label_' | append: forloop.index] | default: product.title
											assign stack_fallback_art = block.settings['stack_art_' | append: forloop.index]
										-%}
										<span class="combo__item">
											{%- render 'card-product',
												product: product,
												compact: true,
												compact_wrapper_class: 'combo__media-wrap',
												compact_media_class: 'combo__media',
												compact_placeholder_class: 'combo__tile',
												compact_fallback_art_class: stack_fallback_art,
												compact_alt: stack_label,
												loading: 'lazy'
											-%}
											<span class="combo__label">{{ stack_label | escape }}</span>
										</span>
										{%- unless forloop.last -%}
											<span class="combo__plus" aria-hidden="true">+</span>
										{%- endunless -%}
									{%- endfor -%}
								{%- elsif combo_image != blank -%}
									<span class="combo__item">
										<span class="combo__media-wrap">
											{{ combo_image | image_url: width: 360 | image_tag: widths: '72,108,144,180,216,288,360', sizes: '(min-width: 760px) 66px, 56px', loading: 'lazy', class: 'combo__media', alt: combo_title | escape }}
										</span>
										<span class="combo__label">{{ block.settings.stack_label_1 | default: combo_title | escape }}</span>
									</span>
								{%- else -%}
									{%- for i in (1..3) -%}
										{%- assign art_key = 'stack_art_' | append: i -%}
										{%- assign label_key = 'stack_label_' | append: i -%}
										{%- assign art_class = block.settings[art_key] -%}
										{%- assign stack_label = block.settings[label_key] -%}
										{%- if art_class != blank or stack_label != blank -%}
											<span class="combo__item">
												{%- render 'card-product',
													compact: true,
													compact_wrapper_class: 'combo__media-wrap',
													compact_media_class: 'combo__media',
													compact_placeholder_class: 'combo__tile',
													compact_fallback_art_class: art_class,
													compact_alt: stack_label,
													loading: 'lazy'
												-%}
												<span class="combo__label">{{ stack_label | escape }}</span>
											</span>
											{%- unless forloop.last -%}
												<span class="combo__plus" aria-hidden="true">+</span>
											{%- endunless -%}
										{%- endif -%}
									{%- endfor -%}
								{%- endif -%}
							</div>
						</div>

						<div class="combo__body">
							<h3>{{ combo_title | escape }}</h3>
							  <div class="combo__cnt">{{ combo_count_display | escape }}</div>
							<div class="combo__inc rte">{{ combo_description }}</div>
							<div class="combo__prow">
								<strong>{{ combo_current_price | escape }}</strong>
								<s>{{ combo_compare_price | escape }}</s>
								<em>{{ combo_save | escape }}</em>
							</div>
							<div class="combo__fine">{{ combo_fine_print | escape }}</div>
							<a class="btn {% if combo_hero %}btn-primary{% else %}btn-ghost{% endif %} combo__btn" href="{{ combo_cta_link }}">
								<span>{{ combo_cta_label | escape }}</span>
				{% render 'icon-arrow-right' %}
							</a>
						</div>
					</article>
					{%- assign rendered_combos = rendered_combos | plus: 1 -%}
				{%- endif -%}
			{%- endfor -%}

			{%- if rendered_combos == 0 -%}
				<div class="glass best-combos__empty">
					<h3>Add combo blocks</h3>
					<p>{{ section.settings.empty_state | default: 'Add combo metaobjects or fallback combo blocks in the editor to render the rail.' }}</p>
				</div>
			{%- endif -%}
		</div>

		<div class="swipecue" aria-hidden="true">
			{% render 'icon-arrow-right' %}
			Swipe for more combos
		</div>
		<p class="railnote">Tapping &quot;Shop bundle&quot; opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
	</div>

	<script>
		(() => {
			const sectionRoot = document.querySelector('[data-combo-rail]')?.closest('.best-combos');
			const rail = document.querySelector('[data-combo-rail]');
			if (!sectionRoot || !rail || sectionRoot.dataset.comboInitialized === 'true') return;
			sectionRoot.dataset.comboInitialized = 'true';

			rail.addEventListener('keydown', (event) => {
				const step = Math.max(rail.clientWidth * 0.82, 220);
				if (event.key === 'ArrowRight' || event.key === 'PageDown') {
					event.preventDefault();
					rail.scrollBy({ left: step, behavior: 'smooth' });
				} else if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
					event.preventDefault();
					rail.scrollBy({ left: -step, behavior: 'smooth' });
				} else if (event.key === 'Home') {
					event.preventDefault();
					rail.scrollTo({ left: 0, behavior: 'smooth' });
				} else if (event.key === 'End') {
					event.preventDefault();
					rail.scrollTo({ left: rail.scrollWidth, behavior: 'smooth' });
				}
			});
		})();
	</script>
</section>

