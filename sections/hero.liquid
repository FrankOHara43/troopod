{% liquid
	assign hero_heading_1 = section.settings.heading_line_1 | default: 'Clean'
	assign hero_heading_2 = section.settings.heading_line_2 | default: 'That'
	assign hero_heading_accent = section.settings.heading_accent | default: 'Lasts'
	assign hero_lede = section.settings.lede | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.'
	assign primary_label = section.settings.primary_button_label | default: 'Shop now'
	assign primary_link = section.settings.primary_button_link | default: '#shop'
	assign secondary_label = section.settings.secondary_button_label | default: 'How it works'
	assign secondary_link = section.settings.secondary_button_link | default: '#how'
	assign promise_rail_label = section.settings.promise_rail_label | default: 'Product promises'
	assign mobile_strip_label = section.settings.mobile_strip_label | default: 'Product promises'
	assign stage_label = section.settings.stage_label | default: 'Hero product rotator'
%}

<section class="purelane-hero" data-purelane-hero data-purelane-hero-id="{{ section.id }}" aria-labelledby="purelane-hero-title-{{ section.id }}">
	<style>
		/* Custom properties below are prototype-specific because Dawn has no exact equivalents for this hero's glass tint, hero geometry, and product-art fallbacks. */
		#shopify-section-{{ section.id }} {
			--hero-max-width: 1180px;
			--hero-pad-x: 18px;
			--hero-pad-top: 150px;
			--hero-pad-bottom: 34px;
			--hero-pad-top-mobile: 132px;
			--hero-bg: linear-gradient(178deg, #1ea38d 0%, #0b8578 22%, #017069 48%, #4b3a8f 74%, #01524e 100%);
			--hero-overlay: linear-gradient(102deg, rgba(1, 45, 42, .68) 0%, rgba(1, 45, 42, .40) 30%, rgba(1, 45, 42, .10) 52%, transparent 66%);
			--hero-overlay-mobile: linear-gradient(180deg, rgba(1, 45, 42, .44) 0%, rgba(1, 45, 42, .22) 34%, rgba(1, 40, 38, .60) 100%);
			--hero-ink: #ece6f7;
			--hero-deep: #241a3d;
			--hero-surface: #faf7fd;
			--hero-accent: #f0a03c;
			--hero-accent-2: #c9761d;
			--hero-brand: #4b3a8f;
			--hero-brand-light: #6b55b8;
			--hero-glass-bg: linear-gradient(158deg, rgba(236, 230, 247, .15), rgba(75, 58, 143, .20) 58%, rgba(23, 16, 43, .28));
			--hero-glass-line: rgba(236, 230, 247, .22);
			--hero-glass-shadow: 0 26px 74px rgba(18, 12, 34, .44);
			--hero-glass-inset: inset 0 1px 0 rgba(255, 255, 255, .24);
			--hero-glass-mobile-bg: linear-gradient(158deg, rgba(236, 230, 247, .10), rgba(0, 48, 46, .22));
			--hero-radius: 26px;
			--hero-radius-sm: 16px;
			--hero-radius-pill: 999px;
			--hero-ease: cubic-bezier(.2, .7, .2, 1);
			--hero-heading-font: var(--font-heading-family, 'Outfit', system-ui, sans-serif);
			--hero-body-font: var(--font-body-family, 'Inter', system-ui, sans-serif);
			--hero-p-kbtl: url("data:image/svg+xml;base64,");
			--hero-p-tbtl: url("data:image/svg+xml;base64,");
			--hero-p-mbtl: url("data:image/svg+xml;base64,");
			--hero-p-kitchen: url("data:image/svg+xml;base64,");
			--hero-p-tap: url("data:image/svg+xml;base64,");
			--hero-p-metal: url("data:image/svg+xml;base64,");
			display: block;
			position: relative;
			z-index: 2;
			min-height: 100svh;
			overflow: hidden;
			background: var(--hero-bg);
			color: var(--hero-ink);
			isolation: isolate;
			font-family: var(--hero-body-font);
		}

		#shopify-section-{{ section.id }} .purelane-hero::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 1;
			pointer-events: none;
			background: var(--hero-overlay);
		}

		#shopify-section-{{ section.id }} .purelane-hero__grid {
			max-width: var(--hero-max-width);
			margin: 0 auto;
			padding: 0 var(--hero-pad-x);
			width: 100%;
			position: relative;
			z-index: 2;
		}

		#shopify-section-{{ section.id }} .purelane-hero__copy {
			max-width: 600px;
			position: relative;
			z-index: 3;
		}

		#shopify-section-{{ section.id }} .purelane-hero__heading {
			margin: 0 0 20px;
			text-shadow: 0 6px 40px rgba(2, 20, 19, .55);
			font-family: var(--hero-heading-font);
			text-transform: uppercase;
			letter-spacing: -.018em;
			font-weight: 800;
			line-height: .87;
			font-size: clamp(48px, 8.6vw, 112px);
			color: var(--hero-surface);
		}

		#shopify-section-{{ section.id }} .purelane-hero__heading span {
			display: block;
		}

		#shopify-section-{{ section.id }} .purelane-hero__heading-accent {
			color: var(--hero-accent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__rule {
			display: flex;
			align-items: center;
			gap: 13px;
			margin: 0 0 20px;
			max-width: 270px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__rule i {
			height: 1px;
			flex: 1;
			background: linear-gradient(90deg, rgba(236, 230, 247, .44), transparent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__rule svg {
			width: 16px;
			height: 16px;
			color: var(--hero-accent);
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .purelane-hero__lede {
			margin: 0;
			max-width: 44ch;
			font-size: clamp(15px, 1.35vw, 17.5px);
			line-height: 1.62;
			color: rgba(236, 230, 247, .74);
		}

		#shopify-section-{{ section.id }} .purelane-hero__cta {
			display: flex;
			gap: 11px;
			flex-wrap: wrap;
			margin-top: 26px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__button {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			min-height: 46px;
			padding: 0 22px;
			border-radius: 999px;
			font-size: 12.5px;
			font-weight: 700;
			letter-spacing: .13em;
			text-transform: uppercase;
			transition: .35s var(--hero-ease);
			white-space: nowrap;
			text-decoration: none;
		}

		#shopify-section-{{ section.id }} .purelane-hero__button svg {
			width: 15px;
			height: 15px;
			flex: 0 0 auto;
		}

		#shopify-section-{{ section.id }} .purelane-hero__button--primary {
			background: linear-gradient(135deg, #f0a03c, #5d8d1c);
			color: #08211a;
			box-shadow: 0 12px 30px rgba(201, 118, 29, .34), inset 0 1px 0 rgba(255, 255, 255, .34);
		}

		#shopify-section-{{ section.id }} .purelane-hero__button--primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 18px 40px rgba(201, 118, 29, .44), inset 0 1px 0 rgba(255, 255, 255, .4);
		}

		#shopify-section-{{ section.id }} .purelane-hero__button--ghost {
			background: rgba(236, 230, 247, .10);
			border: 1px solid rgba(236, 230, 247, .30);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			color: var(--hero-surface);
		}

		#shopify-section-{{ section.id }} .purelane-hero__button--ghost:hover {
			background: rgba(236, 230, 247, .18);
			transform: translateY(-2px);
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-rail,
		#shopify-section-{{ section.id }} .purelane-hero__strip {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-rail {
			position: absolute;
			right: 18px;
			top: 50%;
			transform: translateY(-50%);
			width: 96px;
			z-index: 4;
			display: flex;
			flex-direction: column;
			gap: 2px;
			padding: 12px 8px;
			border-radius: 20px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge {
			text-align: center;
			padding: 11px 4px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge + .purelane-hero__badge {
			border-top: 1px solid rgba(236, 230, 247, .14);
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-icon {
			width: 38px;
			height: 38px;
			margin: 0 auto 8px;
			border-radius: 50%;
			display: grid;
			place-items: center;
			background: rgba(236, 230, 247, .10);
			border: 1px solid rgba(236, 230, 247, .22);
			color: var(--hero-accent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-icon svg {
			width: 19px;
			height: 19px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-copy {
			font-size: 11px;
			font-weight: 700;
			line-height: 1.2;
			color: var(--hero-surface);
		}

		#shopify-section-{{ section.id }} .purelane-hero__badge-copy span {
			display: block;
		}

		#shopify-section-{{ section.id }} .purelane-hero__strip {
			display: none;
			gap: 2px;
			margin-top: 18px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__strip-item {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			justify-content: center;
			min-height: 36px;
			padding: 10px 8px;
			border-radius: 14px;
			background: rgba(236, 230, 247, .10);
			border: 1px solid rgba(236, 230, 247, .16);
			color: var(--hero-surface);
			font-size: 9px;
			font-weight: 700;
			letter-spacing: .02em;
			text-align: center;
		}

		#shopify-section-{{ section.id }} .purelane-hero__strip-item svg {
			width: 16px;
			height: 16px;
			flex: 0 0 auto;
			color: var(--hero-accent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__stage {
			position: absolute;
			right: 2%;
			bottom: 28px;
			width: min(50vw, 560px);
			z-index: 2;
			filter: drop-shadow(0 34px 54px rgba(2, 20, 19, .6));
		}

		#shopify-section-{{ section.id }} .purelane-hero__stage-inner {
			position: relative;
			width: 100%;
			height: clamp(380px, 74svh, 680px);
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: flex-end;
			justify-content: flex-end;
			padding-right: 2%;
			opacity: 0;
			pointer-events: none;
			transition: opacity .85s var(--hero-ease);
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active {
			opacity: 1;
			pointer-events: auto;
		}

		#shopify-section-{{ section.id }} .purelane-hero__art {
			position: relative;
			width: auto;
			flex: 0 0 auto;
			background-repeat: no-repeat;
			background-position: center bottom;
			background-size: contain;
			opacity: 0;
			transform: translateY(28px) scale(.94);
			transition: opacity .8s var(--hero-ease), transform .8s var(--hero-ease);
			filter: drop-shadow(0 26px 40px rgba(1, 22, 20, .66));
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__art {
			opacity: 1;
			transform: none;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__art--d1 { transition-delay: .06s; }
		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__art--d2 { transition-delay: .30s; }
		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__art--d3 { transition-delay: .54s; }

		#shopify-section-{{ section.id }} .purelane-hero__art--fallback {
			display: block;
		}

		#shopify-section-{{ section.id }} .purelane-hero__art--kbtl { background-image: var(--hero-p-kbtl); aspect-ratio: .3229; }
		#shopify-section-{{ section.id }} .purelane-hero__art--tbtl { background-image: var(--hero-p-tbtl); aspect-ratio: .322; }
		#shopify-section-{{ section.id }} .purelane-hero__art--mbtl { background-image: var(--hero-p-mbtl); aspect-ratio: .3416; }
		#shopify-section-{{ section.id }} .purelane-hero__art--kitchen { background-image: var(--hero-p-kitchen); aspect-ratio: .6387; }
		#shopify-section-{{ section.id }} .purelane-hero__art--tap { background-image: var(--hero-p-tap); aspect-ratio: .6387; }
		#shopify-section-{{ section.id }} .purelane-hero__art--metal { background-image: var(--hero-p-metal); aspect-ratio: .6993; }

		#shopify-section-{{ section.id }} .purelane-hero__slide--single .purelane-hero__art--a {
			height: 100%;
			z-index: 3;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide--double .purelane-hero__art--a {
			height: 80%;
			margin-right: -8%;
			z-index: 1;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide--double .purelane-hero__art--b {
			height: 97%;
			z-index: 3;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide--triple .purelane-hero__art--a {
			height: 75%;
			margin-right: -8%;
			z-index: 1;
			order: 1;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide--triple .purelane-hero__art--c {
			height: 97%;
			z-index: 3;
			order: 2;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide--triple .purelane-hero__art--b {
			height: 79%;
			margin-left: -8%;
			z-index: 2;
			order: 3;
		}

		#shopify-section-{{ section.id }} .purelane-hero__art-img {
			display: block;
			width: auto;
			height: 100%;
			object-fit: contain;
		}

		#shopify-section-{{ section.id }} .purelane-hero__price {
			position: absolute;
			left: 0;
			bottom: 2%;
			z-index: 6;
			padding: 11px 14px 12px;
			border-radius: 16px;
			max-width: 52%;
			opacity: 0;
			transform: translateY(16px);
			transition: opacity .8s var(--hero-ease) .62s, transform .8s var(--hero-ease) .62s;
		}

		#shopify-section-{{ section.id }} .purelane-hero__slide.is-active .purelane-hero__price {
			opacity: 1;
			transform: none;
		}

		#shopify-section-{{ section.id }} .purelane-hero__price-label {
			display: block;
			font-size: 9px;
			font-weight: 800;
			letter-spacing: .17em;
			text-transform: uppercase;
			color: var(--hero-accent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__price-row {
			display: flex;
			align-items: baseline;
			gap: 7px;
			margin-top: 5px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__price-row strong {
			font-family: var(--hero-heading-font);
			font-size: 23px;
			font-weight: 800;
			letter-spacing: -.02em;
			color: var(--hero-surface);
			line-height: 1;
		}

		#shopify-section-{{ section.id }} .purelane-hero__price-row s {
			font-size: 12px;
			color: rgba(236, 230, 247, .52);
		}

		#shopify-section-{{ section.id }} .purelane-hero__price-cut {
			display: inline-block;
			margin-top: 7px;
			font-size: 8.4px;
			font-weight: 800;
			letter-spacing: .11em;
			text-transform: uppercase;
			padding: 3px 8px;
			border-radius: 999px;
			background: rgba(240, 160, 60, .20);
			border: 1px solid rgba(240, 160, 60, .38);
			color: var(--hero-accent);
		}

		#shopify-section-{{ section.id }} .purelane-hero__dots {
			display: flex;
			gap: 7px;
			justify-content: center;
			align-items: center;
			margin-top: 8px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__dot {
			width: 6px;
			height: 6px;
			padding: 0;
			border-radius: 50%;
			background: rgba(236, 230, 247, .28);
			transition: .4s var(--hero-ease);
			border: 0;
		}

		#shopify-section-{{ section.id }} .purelane-hero__dot.is-active {
			background: var(--hero-accent);
			width: 20px;
			border-radius: 999px;
		}

		#shopify-section-{{ section.id }} .purelane-hero__dot:hover {
			background: rgba(236, 230, 247, .5);
		}

		#shopify-section-{{ section.id }} .purelane-hero__reveal {
			opacity: 0;
			transform: translateY(30px);
			filter: blur(7px);
			transition: opacity .95s var(--hero-ease), transform .95s var(--hero-ease), filter .95s var(--hero-ease);
		}

		#shopify-section-{{ section.id }} .purelane-hero.is-visible .purelane-hero__reveal {
			opacity: 1;
			transform: none;
			filter: none;
		}

		#shopify-section-{{ section.id }} .purelane-hero__reveal--1 { transition-delay: .09s; }
		#shopify-section-{{ section.id }} .purelane-hero__reveal--2 { transition-delay: .18s; }
		#shopify-section-{{ section.id }} .purelane-hero__reveal--3 { transition-delay: .27s; }
		#shopify-section-{{ section.id }} .purelane-hero__reveal--4 { transition-delay: .36s; }

		@media (max-width: 1200px) {
			#shopify-section-{{ section.id }} .purelane-hero__copy {
				max-width: 470px;
			}

			#shopify-section-{{ section.id }} .purelane-hero__stage {
				width: min(44vw, 440px);
				right: 3%;
			}
		}

		@media (max-width: 900px) {
			#shopify-section-{{ section.id }} .purelane-hero {
				align-items: flex-end;
				padding-top: var(--hero-pad-top-mobile);
				background: var(--hero-bg);
			}

			#shopify-section-{{ section.id }} .purelane-hero::before {
				background: var(--hero-overlay-mobile);
			}

			#shopify-section-{{ section.id }} .purelane-hero__copy {
				max-width: none;
			}

			#shopify-section-{{ section.id }} .purelane-hero__badge-rail {
				display: none;
			}

			#shopify-section-{{ section.id }} .purelane-hero__strip {
				display: flex;
			}

			#shopify-section-{{ section.id }} .purelane-hero__stage {
				position: relative;
				right: auto;
				bottom: auto;
				width: min(88vw, 420px);
				margin: 20px auto 0;
			}

			#shopify-section-{{ section.id }} .purelane-hero__stage-inner {
				height: clamp(300px, 44svh, 430px);
			}

			#shopify-section-{{ section.id }} .purelane-hero__price {
				padding: 9px 12px 10px;
				border-radius: 14px;
				max-width: 58%;
			}

			#shopify-section-{{ section.id }} .purelane-hero__price-row strong {
				font-size: 20px;
			}
		}

		@media (max-width: 420px) {
			#shopify-section-{{ section.id }} .purelane-hero__strip-item {
				font-size: 8px;
				padding: 9px 4px;
			}

			#shopify-section-{{ section.id }} .purelane-hero__strip-item svg {
				width: 16px;
				height: 16px;
			}

			#shopify-section-{{ section.id }} .purelane-hero__stage {
				width: min(92vw, 360px);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			#shopify-section-{{ section.id }} .purelane-hero *,
			#shopify-section-{{ section.id }} .purelane-hero *::before,
			#shopify-section-{{ section.id }} .purelane-hero *::after {
				animation-duration: .01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: .01ms !important;
				scroll-behavior: auto !important;
			}

			#shopify-section-{{ section.id }} .purelane-hero__reveal {
				opacity: 1;
				transform: none;
				filter: none;
			}

			#shopify-section-{{ section.id }} .purelane-hero__slide,
			#shopify-section-{{ section.id }} .purelane-hero__art,
			#shopify-section-{{ section.id }} .purelane-hero__price {
				transition: none !important;
			}
		}
	</style>

	<div class="purelane-hero__grid">
		<ul class="purelane-hero__badge-rail glass-2 purelane-hero__reveal purelane-hero__reveal--1" aria-label="{{ promise_rail_label | escape }}">
			{% for block in section.blocks %}
				{% if block.type == 'promise' %}
					<li class="purelane-hero__badge" {{ block.shopify_attributes }}>
						<span class="purelane-hero__badge-icon" aria-hidden="true">
							{% case block.settings.icon %}
								{% when 'shield' %}
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
								{% when 'circle' %}
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
								{% else %}
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
							{% endcase %}
						</span>
						<span class="purelane-hero__badge-copy">
							<span>{{ block.settings.desktop_line_1 | escape }}</span>
							<span>{{ block.settings.desktop_line_2 | escape }}</span>
						</span>
					</li>
				{% endif %}
			{% endfor %}
		</ul>

		<div class="purelane-hero__copy">
			<h1 id="purelane-hero-title-{{ section.id }}" class="purelane-hero__heading purelane-hero__reveal purelane-hero__reveal--1">
				<span>{{ hero_heading_1 | escape }}</span>
				<span>{{ hero_heading_2 | escape }}</span>
				<span class="purelane-hero__heading-accent">{{ hero_heading_accent | escape }}</span>
			</h1>

			<div class="purelane-hero__rule purelane-hero__reveal purelane-hero__reveal--2" aria-hidden="true">
				<i></i>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
				<i></i>
			</div>

			<p class="purelane-hero__lede purelane-hero__reveal purelane-hero__reveal--3">{{ hero_lede | escape }}</p>

			<div class="purelane-hero__cta purelane-hero__reveal purelane-hero__reveal--4">
				<a class="purelane-hero__button purelane-hero__button--primary" href="{{ primary_link }}">
					<span>{{ primary_label | escape }}</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
				</a>
				<a class="purelane-hero__button purelane-hero__button--ghost" href="{{ secondary_link }}">{{ secondary_label | escape }}</a>
			</div>

			<div class="purelane-hero__strip purelane-hero__reveal purelane-hero__reveal--4" aria-label="{{ mobile_strip_label | escape }}">
				{% for block in section.blocks %}
					{% if block.type == 'promise' %}
						<div class="purelane-hero__strip-item" {{ block.shopify_attributes }}>
							<span aria-hidden="true">
								{% case block.settings.icon %}
									{% when 'shield' %}
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
									{% when 'circle' %}
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
									{% else %}
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
								{% endcase %}
							</span>
							<span>{{ block.settings.mobile_label | escape }}</span>
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</div>

		<div class="purelane-hero__stage purelane-hero__reveal purelane-hero__reveal--2" data-hero-stage aria-label="{{ stage_label | escape }}">
			<div class="purelane-hero__stage-inner">
				{% assign slide_index = 0 %}
				{% for block in section.blocks %}
					{% if block.type == 'slide' %}
						{% assign slide_index = slide_index | plus: 1 %}
						<div class="purelane-hero__slide purelane-hero__slide--{{ block.settings.layout }}{% if slide_index == 1 %} is-active{% endif %}" data-hero-slide="{{ slide_index | minus: 1 }}" {{ block.shopify_attributes }}>
							{% if block.settings.layout == 'single' %}
								{% if block.settings.image_1 != blank %}
									{{ block.settings.image_1 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--a', alt: block.settings.alt_1 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--a purelane-hero__art--fallback purelane-hero__art--kbtl" role="img" aria-label="{{ block.settings.alt_1 | escape }}"></span>
								{% endif %}
							{% elsif block.settings.layout == 'double' %}
								{% if block.settings.image_1 != blank %}
									{{ block.settings.image_1 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--a', alt: block.settings.alt_1 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--a purelane-hero__art--fallback purelane-hero__art--tap" role="img" aria-label="{{ block.settings.alt_1 | escape }}"></span>
								{% endif %}

								{% if block.settings.image_2 != blank %}
									{{ block.settings.image_2 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--b', alt: block.settings.alt_2 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--b purelane-hero__art--fallback purelane-hero__art--kbtl" role="img" aria-label="{{ block.settings.alt_2 | escape }}"></span>
								{% endif %}
							{% else %}
								{% if block.settings.image_1 != blank %}
									{{ block.settings.image_1 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--a', alt: block.settings.alt_1 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--a purelane-hero__art--fallback purelane-hero__art--tap" role="img" aria-label="{{ block.settings.alt_1 | escape }}"></span>
								{% endif %}

								{% if block.settings.image_3 != blank %}
									{{ block.settings.image_3 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--c', alt: block.settings.alt_3 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--c purelane-hero__art--fallback purelane-hero__art--kbtl" role="img" aria-label="{{ block.settings.alt_3 | escape }}"></span>
								{% endif %}

								{% if block.settings.image_2 != blank %}
									{{ block.settings.image_2 | image_url: width: 1200 | image_tag: class: 'purelane-hero__art purelane-hero__art--b', alt: block.settings.alt_2 | escape, loading: 'eager' }}
								{% else %}
									<span class="purelane-hero__art purelane-hero__art--b purelane-hero__art--fallback purelane-hero__art--metal" role="img" aria-label="{{ block.settings.alt_2 | escape }}"></span>
								{% endif %}
							{% endif %}

							<div class="purelane-hero__price glass-2">
								<span class="purelane-hero__price-label">{{ block.settings.label | escape }}</span>
								<span class="purelane-hero__price-row">
									<strong>{{ block.settings.current_price | escape }}</strong>
									<s>{{ block.settings.compare_price | escape }}</s>
								</span>
								<span class="purelane-hero__price-cut">{{ block.settings.saving | escape }}</span>
							</div>
						</div>
					{% endif %}
				{% endfor %}
			</div>

			<div class="purelane-hero__dots" aria-label="{{ stage_label | escape }} controls">
				{% assign dot_index = 0 %}
				{% for block in section.blocks %}
					{% if block.type == 'slide' %}
						{% assign dot_index = dot_index | plus: 1 %}
						<button
							class="purelane-hero__dot{% if dot_index == 1 %} is-active{% endif %}"
							type="button"
							data-hero-dot="{{ dot_index | minus: 1 }}"
							aria-label="{{ block.settings.control_label | escape }}"
							{% if dot_index == 1 %}aria-current="true"{% endif %}
						></button>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>

	<script>
		(() => {
			const sectionRoot = document.querySelector('[data-purelane-hero-id="{{ section.id }}"]');
			if (!sectionRoot || sectionRoot.dataset.heroInitialized === 'true') return;

			sectionRoot.dataset.heroInitialized = 'true';
			const reduceQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
			const prefersReducedMotion = !!(reduceQuery && reduceQuery.matches);
			const stage = sectionRoot.querySelector('[data-hero-stage]');
			const slides = Array.from(sectionRoot.querySelectorAll('[data-hero-slide]'));
			const dots = Array.from(sectionRoot.querySelectorAll('[data-hero-dot]'));
			let activeIndex = 0;
			let timer = null;

			function setActive(index) {
				if (!slides.length) return;
				activeIndex = (index + slides.length) % slides.length;
				slides.forEach((slide, slideIndex) => {
					slide.classList.toggle('is-active', slideIndex === activeIndex);
				});
				dots.forEach((dot, dotIndex) => {
					const isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					if (isActive) {
						dot.setAttribute('aria-current', 'true');
					} else {
						dot.removeAttribute('aria-current');
					}
				});
			}

			function stop() {
				if (timer) {
					window.clearInterval(timer);
					timer = null;
				}
			}

			function play() {
				if (prefersReducedMotion || timer || slides.length < 2) return;
				timer = window.setInterval(() => {
					setActive(activeIndex + 1);
				}, 3800);
			}

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					stop();
					setActive(index);
					play();
				});
			});

			if (stage) {
				stage.addEventListener('mouseenter', stop);
				stage.addEventListener('mouseleave', play);
			}

			if ('IntersectionObserver' in window) {
				const visibleObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							sectionRoot.classList.add('is-visible');
							setActive(activeIndex);
							play();
						} else {
							stop();
						}
					});
				}, { threshold: 0.2 });

				visibleObserver.observe(sectionRoot);
			} else {
				sectionRoot.classList.add('is-visible');
				play();
			}

			if (prefersReducedMotion) {
				stop();
				sectionRoot.classList.add('is-visible');
			}

			if (reduceQuery && typeof reduceQuery.addEventListener === 'function') {
				reduceQuery.addEventListener('change', (event) => {
					if (event.matches) {
						stop();
						sectionRoot.classList.add('is-visible');
					} else {
						play();
					}
				});
			}

			setActive(0);
			sectionRoot.classList.add('is-visible');
		})();
	</script>
</section>

